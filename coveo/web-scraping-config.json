[
  {
    "name": "pokemon-page",
    "for": {
      "urls": ["^https://pokemondb\\.net/pokedex/[a-z0-9-]+$"]
    },
    "exclude": [
      {
        "type": "CSS",
        "path": "header, footer, nav, .breadcrumb, .resp-tab-content, .infocard-list, .panel-pokedex-related, script, style"
      }
    ],
    "metadata": {
      "pokemonname": {
        "type": "CSS",
        "path": "h1::text"
      },
      "pokemonnatdex": {
        "type": "XPATH",
        "path": "(//th[contains(normalize-space(text()),'National')]/following-sibling::td/strong/text())[1]"
      },
      "pokemontypes": {
        "type": "XPATH",
        "path": "(//th[normalize-space(text())='Type']/following-sibling::td)[1]//a[contains(@href,'/type/')]/text()"
      },
      "pokemonspecies": {
        "type": "XPATH",
        "path": "(//th[normalize-space(text())='Species']/following-sibling::td/text())[1]"
      },
      "pokemonheight": {
        "type": "XPATH",
        "path": "(//th[normalize-space(text())='Height']/following-sibling::td/text())[1]"
      },
      "pokemonweight": {
        "type": "XPATH",
        "path": "(//th[normalize-space(text())='Weight']/following-sibling::td/text())[1]"
      },
      "pokemonabilities": {
        "type": "XPATH",
        "path": "(//th[normalize-space(text())='Abilities']/following-sibling::td)[1]//a[contains(@href,'/ability/')]/text()"
      },
      "pokemonimage": {
        "type": "XPATH",
        "path": "(//img[contains(@src,'img.pokemondb.net/artwork/')]/@src)[1]"
      }
    }
  }
]
